+++ b/interdrv/vc_drv/driver/enc_api/src/rc/cvi_rc_model.h
@@ -80,6 +80,14 @@ struct rc_model_ctx_s {
 	int frame_rate;
 	int pbits_used;
 
+	int vbr_rc_gop_size;		/* rc_gop window size (fixed divisor of GOP) */
+	int vbr_rc_gop_target_bits;	/* rc_gop target bits (change_pos scaled) */
+	int vbr_rc_gop_max_bits;	/* rc_gop max bits (hard max_bitrate ceiling) */
+	int vbr_rc_gop_accum_bits;	/* accumulated bits in current rc_gop window */
+	int vbr_rc_gop_frame_cnt;	/* frame count in current rc_gop window */
+	int vbr_qp_accum;		/* Range [VBR_QP_ACCUM_MIN, VBR_QP_ACCUM_MAX]; QP smoothing accumulator */
+	int vbr_sensitivity;		/* Layer 1 step scaling factor (from initial_delay, default 1000) */
+
 	unsigned int rc_kernel_init;
 };
 
diff --git a/interdrv/vc_drv/driver/enc_api/src/rc/vc_rc_cfg.h b/interdrv/vc_drv/driver/enc_api/src/rc/vc_rc_cfg.h
index 3c0d90f2..ccc94f9d 100644
--- a/interdrv/vc_drv/driver/enc_api/src/rc/vc_rc_cfg.h
+++ b/interdrv/vc_drv/driver/enc_api/src/rc/vc_rc_cfg.h
@@ -16,6 +16,19 @@
 #define AVBR_MOT_LV_DEFAULT 			(32)
 #define AVBR_MOT_LOWER_THR 				(64)
 
+/* VBR QP adjustment parameters */
+#define VBR_RC_GOP_ITER_NUM		(6)    /* rc_gop subdivision count per GOP, must match rc_kernel */
+#define VBR_QP_ACCUM_MIN		(-2)   /* lower bound of persistent QP delta (quality boost limit) */
+#define VBR_QP_ACCUM_MAX		(8)    /* upper bound of persistent QP delta (bitrate cap limit) */
+#define VBR_QP_ACCUM_STEP_HARD		(2)    /* Layer 1 accumulator step: hard ceiling exceeded */
+#define VBR_QP_ACCUM_STEP_SOFT		(1)    /* Layer 1 accumulator step: target-based adjustment */
+#define VBR_UPPER_RATIO_THR			(100)  /* accum/max_bits %: above → hard suppression */
+#define VBR_LOWER_RATIO_THR_HI		(100)  /* accum/target_bits %: above → soft suppression */
+#define VBR_LOWER_RATIO_THR_LO		(90)   /* accum/target_bits %: below → quality boost */
+#define VBR_INSTANT_DELTA_HIGH		(2)    /* instant QP boost when proportional max budget exceeded */
+#define VBR_INSTANT_DELTA_LOW		(1)    /* instant QP boost when proportional target budget exceeded */
+#define VBR_LAYER2_MIN_FRAMES		(2)    /* min frames in rc_gop before Layer 2 activates */
+
 struct vc_rc_impl_s;
 struct rc_cfg_s {
 	/* encode image size */
@@ -67,6 +80,8 @@ struct rc_cfg_s {
 	struct debreatheffect_s debreath_effect;
 	unsigned int svc_enable;
 
+	int initial_delay;
+
 	int max_re_encode_times;
