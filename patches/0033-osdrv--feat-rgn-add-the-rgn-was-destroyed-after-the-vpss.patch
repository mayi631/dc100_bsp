@@ -323,6 +371,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(vpss_grp, vpss_chn, cores);
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		if (dev_idx > 1)
 			layer = 0;
 
@@ -338,6 +391,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(vpss_grp, vpss_chn, cores);
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		if (dev_idx > 1)
 			layer = 0;
 
@@ -353,6 +411,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(vpss_grp, vpss_chn, cores);
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
