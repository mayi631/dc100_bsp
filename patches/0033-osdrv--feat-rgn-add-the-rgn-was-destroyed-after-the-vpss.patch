@@ -290,6 +323,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		vpss_grp vpss_grp = attr->chn.dev_id;
 		vpss_chn vpss_chn = attr->chn.chn_id;
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
