diff --git a/interdrv/rgn/driver/rgn.c b/interdrv/rgn/driver/rgn.c
index bfc75635..67fc5083 100644
--- a/interdrv/rgn/driver/rgn.c
+++ b/interdrv/rgn/driver/rgn.c
@@ -108,6 +108,11 @@ static int _rgn_call_cb(unsigned int m_id, unsigned int cmd_id, void *data)
 	return base_exe_module_cb(&exe_cb);
 }
 
+static bool _rgn_cb_is_vpss_unavailable(int ret)
+{
+	return (ret == -1 || ret == ERR_VPSS_UNEXIST);
+}
+
 int32_t _rgn_init(void)
 {
 	rgn_hash = osal_hash_create(64);
@@ -958,6 +963,7 @@ static int _rgn_get_chn_info(struct rgn_ctx *ctx,
 	rgn_handle *hdls, unsigned char *size)
 {
 	struct _rgn_hdls_cb_param rgn_hdls_arg;
+	int ret;
 
 	rgn_hdls_arg.chn = ctx->chn;
 	rgn_hdls_arg.hdls = hdls;
@@ -979,9 +985,11 @@ static int _rgn_get_chn_info(struct rgn_ctx *ctx,
 			*size = RGN_MOSAIC_MAX_NUM;
 		}
 
-		if (_rgn_call_cb(E_MODULE_VPSS, VPSS_CB_GET_RGN_HDLS, &rgn_hdls_arg) != 0) {
-			TRACE_RGN(RGN_ERR, "VPSS_CB_GET_RGN_HDLS is failed\n");
-			return ERR_RGN_ILLEGAL_PARAM;
+		ret = _rgn_call_cb(E_MODULE_VPSS, VPSS_CB_GET_RGN_HDLS, &rgn_hdls_arg);
+		if (ret != 0) {
+			if (!_rgn_cb_is_vpss_unavailable(ret))
+				TRACE_RGN(RGN_ERR, "VPSS_CB_GET_RGN_HDLS is failed\n");
+			return ret;
 		}
 	} else {
 		return ERR_RGN_INVALID_DEVID;
@@ -1669,14 +1677,38 @@ RGN_FMT_INCORRECT:
 	return ret;
 }
 
+static void _rgn_free_canvas(struct rgn_ctx *ctx)
+{
+	unsigned char i;
+	unsigned char canvas_num = 1;
+
+	if (ctx->chn_attr.type == OVERLAY_RGN) {
+		canvas_num = ctx->region.unattr.overlay.canvas_num;
+	} else if (ctx->chn_attr.type == OVERLAYEX_RGN) {
+		canvas_num = ctx->region.unattr.overlay_ex.canvas_num;
+	}
+
+	for (i = 0; i < canvas_num; ++i) {
+		if (ctx->canvas_info[i].phy_addr)
+			base_ion_free(ctx->canvas_info[i].phy_addr);
+
+		ctx->canvas_info[i].phy_addr = 0;
+		ctx->canvas_info[i].virt_addr = NULL;
+	}
+
+	ctx->ion_len = 0;
+	ctx->max_need_ion = 0;
+}
+
 int rgn_detach_from_chn(rgn_handle handle, const mmf_chn_s *pchn)
 {
 	struct rgn_ctx *ctx = NULL;
 	int ret = OSAL_SUCCESS;
 	unsigned int proc_idx;
 	int ret_tmp;
-	unsigned char i;
 	struct _rgn_clr_ow_addr_cb_param cb_param;
+	bool vpss_available = true;
+	bool ow_inst_valid = false;
 
 	ret_tmp = check_rgn_handle(&ctx, handle);
 	if (ret_tmp != 0)
@@ -1691,6 +1723,7 @@ int rgn_detach_from_chn(rgn_handle handle, const mmf_chn_s *pchn)
 
 	osal_mutex_lock(&g_rgnlock);
 
+	osal_memset(&cb_param, 0, sizeof(cb_param));
 	cb_param.chn = ctx->chn;
 	cb_param.handle = handle;
 	if (ctx->canvas_info[ctx->canvas_idx].compressed) {
@@ -1700,35 +1733,43 @@ int rgn_detach_from_chn(rgn_handle handle, const mmf_chn_s *pchn)
 	}
 
 	if (ctx->region.type == OVERLAY_RGN || ctx->region.type == COVER_RGN) {
-		if (_rgn_call_cb(E_MODULE_VPSS, VPSS_CB_GET_RGN_OW_INST, &cb_param) != 0) {
-			TRACE_RGN(RGN_ERR, "VPSS_CB_GET_RGN_OW_INST is failed\n");
+		ret_tmp = _rgn_call_cb(E_MODULE_VPSS, VPSS_CB_GET_RGN_OW_INST, &cb_param);
+		if (ret_tmp != 0) {
+			if (_rgn_cb_is_vpss_unavailable(ret_tmp)) {
+				vpss_available = false;
+			} else {
+				TRACE_RGN(RGN_ERR, "VPSS_CB_GET_RGN_OW_INST is failed\n");
+			}
+		} else {
+			ow_inst_valid = true;
+		}
+	}
+
+	if (vpss_available) {
+		ret = _rgn_update_hw(ctx, RGN_OP_REMOVE);
+		if (_rgn_cb_is_vpss_unavailable(ret)) {
+			TRACE_RGN(RGN_INFO, "VPSS is unavailable, detach rgn_handle(%d) locally.\n", handle);
+			vpss_available = false;
+			ret = OSAL_SUCCESS;
 		}
 	}
 
-	ret = _rgn_update_hw(ctx, RGN_OP_REMOVE);
 	if (ret == 0) {
 		ctx->chn.mod_id = rgn_prc_ctx[proc_idx].chn.mod_id = ID_BASE;
 		rgn_prc_ctx[proc_idx].used = false;
 	}
 	ctx->odec_data_valid = false;
 
-	/*Waiting for the VPSS to truly close the RGN*/
-	osal_msleep(200);
-
-	if (ctx->chn_attr.type == OVERLAY_RGN) {
-		for (i = 0; i < ctx->region.unattr.overlay.canvas_num; ++i)
-			if (ctx->canvas_info[i].phy_addr)
-				base_ion_free(ctx->canvas_info[i].phy_addr);
-	} else if (ctx->chn_attr.type == OVERLAYEX_RGN) {
-		for (i = 0; i < ctx->region.unattr.overlay_ex.canvas_num; ++i)
-			if (ctx->canvas_info[i].phy_addr)
-				base_ion_free(ctx->canvas_info[i].phy_addr);
-	} else {
-		if (ctx->canvas_info[0].phy_addr)
-			base_ion_free(ctx->canvas_info[0].phy_addr);
+	if (vpss_available) {
+		/* Waiting for the VPSS to truly close the RGN. */
+		osal_msleep(200);
 	}
 
-	if (ctx->region.type == OVERLAY_RGN || ctx->region.type == COVER_RGN) {
+	if (ret == 0)
+		_rgn_free_canvas(ctx);
+
+	if (vpss_available && ow_inst_valid &&
+	    (ctx->region.type == OVERLAY_RGN || ctx->region.type == COVER_RGN)) {
 		if (_rgn_call_cb(E_MODULE_VPSS, VPSS_CB_CLR_RGN_OW_ADDR, &cb_param) != 0) {
 			TRACE_RGN(RGN_ERR, "VPSS_CB_CLR_RGN_OW_ADDR is failed\n");
 		}
@@ -1845,12 +1886,16 @@ int rgn_get_canvas_info(rgn_handle handle, rgn_canvas_info_s *pcanvas_info)
 		TRACE_RGN(RGN_INFO, "canvas p_addr(%llx) v_addr(%lx).\n"
 			, pcanvas_info->phy_addr, (uintptr_t)pcanvas_info->virt_addr);
 
+		osal_memset(&cb_param, 0, sizeof(cb_param));
 		cb_param.chn = ctx->chn;
 		cb_param.handle = handle;
 		cb_param.layer = RGN_ODEC_LAYER_VPSS;
 
 		do {
-			if (_rgn_call_cb(E_MODULE_VPSS, VPSS_CB_GET_RGN_OW_ADDR, &cb_param) != 0) {
+			ret = _rgn_call_cb(E_MODULE_VPSS, VPSS_CB_GET_RGN_OW_ADDR, &cb_param);
+			if (ret != 0) {
+				if (_rgn_cb_is_vpss_unavailable(ret))
+					break;
 				TRACE_RGN(RGN_ERR, "VPSS_CB_GET_RGN_OW_ADDR is failed\n");
 					return ERR_RGN_ILLEGAL_PARAM;
 			}
@@ -2039,6 +2084,8 @@ retry:
 	ctx->canvas_updated = true;
 	ret = _rgn_update_hw(ctx, RGN_OP_UPDATE);
 	ctx->canvas_updated = false;
+	if (_rgn_cb_is_vpss_unavailable(ret))
+		ret = OSAL_SUCCESS;
 
 	ctx->canvas_get = 0;
 	return ret;
diff --git a/interdrv/vpss/driver/vpss_core.c b/interdrv/vpss/driver/vpss_core.c
