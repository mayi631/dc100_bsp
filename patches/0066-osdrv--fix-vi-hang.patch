From 49de1164c0bd61c13180a80c182fcd502010e2db Mon Sep 17 00:00:00 2001
From: "xiaole.chen" <xiaole.chen@sophgo.com>
Date: Tue, 28 Jul 2026 20:11:34 +0800
Subject: [PATCH] fix: vi hang

Change-Id: Iebbdc47fa05930c2b8ff4941629f4b6621222615
---
 interdrv/vi/driver/vi.c           | 42 ++++++++++++++++++++++++-------
 interdrv/vi/driver/vi_defines.h   |  1 +
 interdrv/vi/driver/vi_sdk_layer.c |  1 -
 3 files changed, 34 insertions(+), 10 deletions(-)

diff --git a/interdrv/vi/driver/vi.c b/interdrv/vi/driver/vi.c
index 92691da8..4c7fb770 100755
--- a/interdrv/vi/driver/vi.c
+++ b/interdrv/vi/driver/vi.c
@@ -2678,6 +2678,11 @@ static void vi_handle_offline_frm_done(struct vi_dev *vdev, struct _vi_buffer *b
 		return;
 	}
 
+	if (vdev->vi_dqbuf == NULL || vdev->vi_qbuf == NULL) {
+		vi_pr(VI_DBG, "pipe(%d) chn(%d) vi_dqbuf or vi_qbuf is null.\n", pipe, chn);
+		return;
+	}
+
 	blk = vdev->vi_dqbuf(mmf_chn, vdev);
 	if (blk == VB_INVALID_HANDLE) {
 		vi_pr(VI_ERR, "pipe(%d) chn(%d) can't get vb-blk.\n", pipe, chn);
@@ -2725,7 +2730,7 @@ static int _vi_event_handler_thread(void *arg)
 	struct _vi_buffer b;
 	uint32_t flag = 0;
 
-	while (!osal_atomic_read(&vdev->vi_th[th_id].exit_flag)) {
+	while (!osal_atomic_read(&vdev->vi_th[th_id].thread_exit)) {
 		ret = osal_wait_timeout_uninterruptible(&vdev->vi_th[th_id].wq,
 					vi_event_thread_wait_cond_func,
 					vdev,
@@ -3095,7 +3100,7 @@ static int _vi_err_handler_thread(void *arg)
 	enum sop_isp_raw err_raw_num = ISP_PRERAW0;
 	enum E_VI_TH th_id = E_VI_TH_ERR_HANDLER;
 
-	while (!osal_atomic_read(&vdev->vi_th[th_id].exit_flag)) {
+	while (!osal_atomic_read(&vdev->vi_th[th_id].thread_exit)) {
 		ret = osal_wait_timeout_uninterruptible(&vdev->vi_th[th_id].wq,
 							vi_err_wait_cond_func,
 							vdev,
@@ -3399,7 +3404,7 @@ static int _vi_preraw_thread(void *arg)
 	u8 pipe = 0;
 	enum E_VI_TH th_id = E_VI_TH_PRERAW;
 
-	while (!osal_atomic_read(&vdev->vi_th[th_id].exit_flag)) {
+	while (!osal_atomic_read(&vdev->vi_th[th_id].thread_exit)) {
 		ret = osal_wait_timeout_uninterruptible(&vdev->vi_th[th_id].wq,
 							vi_preraw_wait_cond_func,
 							vdev,
@@ -3628,7 +3633,7 @@ static int _vi_ai_isp_handler_thread(void *arg)
 	struct vi_dev *vdev = (struct vi_dev *)arg;
 	enum E_VI_TH th_id = E_VI_TH_AI_ISP;
 
-	while (!osal_atomic_read(&vdev->vi_th[th_id].exit_flag)) {
+	while (!osal_atomic_read(&vdev->vi_th[th_id].thread_exit)) {
 		ret = osal_wait_timeout_uninterruptible(&vdev->vi_th[th_id].wq,
 							vi_ai_isp_wait_cond_func,
 							vdev,
@@ -3671,7 +3676,7 @@ static int _vi_vblank_handler_thread(void *arg)
 	enum sop_isp_raw raw_num = ISP_PRERAW0;
 	enum E_VI_TH th_id = E_VI_TH_VBLANK_HANDLER;
 
-	while (!osal_atomic_read(&vdev->vi_th[th_id].exit_flag)) {
+	while (!osal_atomic_read(&vdev->vi_th[th_id].thread_exit)) {
 		ret = osal_wait_timeout_uninterruptible(&vdev->vi_th[th_id].wq,
 							vi_vblank_wait_cond_func,
 							vdev,
@@ -5306,6 +5311,8 @@ int vi_resume(struct vi_dev *vdev)
 
 void vi_destroy_thread(struct vi_dev *vdev, enum E_VI_TH th_id)
 {
+	osal_task *thread = NULL;
+
 	if (th_id < 0 || th_id >= E_VI_TH_MAX) {
 		vi_pr(VI_ERR, "No such thread_id(%d)\n", th_id);
 		return;
@@ -5318,12 +5325,16 @@ void vi_destroy_thread(struct vi_dev *vdev, enum E_VI_TH th_id)
 		return;
 	}
 
-	if (vdev->vi_th[th_id].w_thread != NULL) {
+	osal_spin_lock_bh(&vdev->vi_th[th_id].lock);
+	thread = vdev->vi_th[th_id].w_thread;
+	vdev->vi_th[th_id].w_thread = NULL;
+	osal_spin_unlock_bh(&vdev->vi_th[th_id].lock);
+
+	if (thread != NULL) {
 		osal_atomic_set(&vdev->vi_th[th_id].exit_flag, 1);
 		osal_wait_wakeup(&vdev->vi_th[th_id].wq);
-		osal_kthread_destroy(vdev->vi_th[th_id].w_thread, 1);
+		osal_kthread_destroy(thread, 1);
 
-		vdev->vi_th[th_id].w_thread = NULL;
 		osal_wait_destroy(&vdev->vi_th[th_id].wq);
 	}
 }
@@ -5497,6 +5508,9 @@ static void vi_init_resources(struct vi_dev *vdev)
 			vdev->qbuf_q[i][j].num = 0;
 		}
 	}
+
+	for (i = 0; i < E_VI_TH_MAX; i++)
+		osal_spin_lock_init(&vdev->vi_th[i].lock);
 }
 
 static void vi_deinit_resources(struct vi_dev *vdev)
@@ -5504,6 +5518,9 @@ static void vi_deinit_resources(struct vi_dev *vdev)
 	struct isp_ctx *ctx = &vdev->ctx;
 	int i = 0, j = 0;
 
+	for (i = 0; i < E_VI_TH_MAX; i++)
+		osal_spin_lock_destroy(&vdev->vi_th[i].lock);
+
 	isp_raw_dump_deinit(vdev);
 
 	for (i = 0; i < ISP_PRERAW_MAX; i++) {
@@ -5551,6 +5568,12 @@ int vi_create_instance(struct vi_dev *vdev)
 
 	vi_init_resources(vdev);
 
+	ret = vi_create_thread(vdev, E_VI_TH_EVENT_HANDLER);
+	if (ret) {
+		vi_pr(VI_ERR, "Failed to create event_handler thread\n");
+		goto err_create_event;
+	}
+
 	ret = vi_create_thread(vdev, E_VI_TH_PRERAW);
 	if (ret) {
 		vi_pr(VI_ERR, "Failed to create preraw thread\n");
@@ -5584,7 +5607,8 @@ err_create_err:
 err_create_vblank:
 	vi_destroy_thread(vdev, E_VI_TH_PRERAW);
 err_create_preraw:
-
+	vi_destroy_thread(vdev, E_VI_TH_EVENT_HANDLER);
+err_create_event:
 	return ret;
 }
 
diff --git a/interdrv/vi/driver/vi_defines.h b/interdrv/vi/driver/vi_defines.h
index ed651040..c72493c6 100644
--- a/interdrv/vi/driver/vi_defines.h
+++ b/interdrv/vi/driver/vi_defines.h
@@ -43,6 +43,7 @@ enum E_STATE_S {
 struct vi_thread_attr {
 	char			th_name[32];
 	osal_task		*w_thread;
+	osal_spinlock		lock;
 	osal_atomic		thread_exit;
 	osal_wait		wq;
 	osal_atomic		flag;
diff --git a/interdrv/vi/driver/vi_sdk_layer.c b/interdrv/vi/driver/vi_sdk_layer.c
index c233cb2c..50d7a9f2 100644
--- a/interdrv/vi/driver/vi_sdk_layer.c
+++ b/interdrv/vi/driver/vi_sdk_layer.c
@@ -1151,7 +1151,6 @@ int vi_disable_chn(struct vi_dev *vdev, int pipe, int chn)
 	}
 
 	if (!is_streaming) {
-		vi_destroy_thread(vdev, E_VI_TH_EVENT_HANDLER);
 		vi_destroy_dbg_thread(vdev);
 		vdev->vi_qbuf = NULL;
 		vdev->vi_dqbuf = NULL;
-- 
2.25.1

