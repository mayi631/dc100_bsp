+#define ADC_TRIM(reg_base)                                                     \
+  (*((__IM uint32_t *)((reg_base) + (cvi_adc_reg->TRIM))))
+
+static inline void adc_start(unsigned long reg_base) {
+  uint32_t ctrl = ADC_CTRL(reg_base);
+  ctrl &= ~(ADC_CTRL_ADC_EN | ADC_CTRL_ADC_START);
+  ADC_CTRL(reg_base) = ctrl;
+  ctrl |= (ADC_CTRL_ADC_EN | ADC_CTRL_ADC_START);
+  ADC_CTRL(reg_base) = ctrl;
