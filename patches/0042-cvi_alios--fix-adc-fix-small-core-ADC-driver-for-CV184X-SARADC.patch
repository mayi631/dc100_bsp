-static inline void adc_start(unsigned long reg_base)
-{
-    pr_debug("write reg %08p value %#x\n", &ADC_CTRL(reg_base), ADC_CTRL(reg_base) | ADC_CTRL_ADC_START);
-    ADC_CTRL(reg_base) |= ADC_CTRL_ADC_START;
