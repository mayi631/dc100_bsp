diff --git a/interdrv/tde/chip/cv184x/tde_reg.c b/interdrv/tde/chip/cv184x/tde_reg.c
index ba9cbc24..c809c309 100644
--- a/interdrv/tde/chip/cv184x/tde_reg.c
