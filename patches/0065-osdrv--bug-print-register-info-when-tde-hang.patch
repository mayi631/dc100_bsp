diff --git a/interdrv/tde/chip/cv184x/tde_reg.c b/interdrv/tde/chip/cv184x/tde_reg.c
index ba9cbc24..4de81584 100644
--- a/interdrv/tde/chip/cv184x/tde_reg.c
+++ b/interdrv/tde/chip/cv184x/tde_reg.c
@@ -97,4 +97,62 @@ void tde_toggle_reset(void)
 	osal_iounmap(vi_sys_addr, 4);
 }
 
+void tde_dump_reg(void)
+{
+	TRACE_TDE(DBG_ERR, "===== TDE reg dump =====\n");
+	TRACE_TDE(DBG_ERR, "SURFACE_REG0          [0x%02x]: 0x%08x\n",
+		TDE_REG_SURFACE_REG0, _reg_read(reg_base + TDE_REG_SURFACE_REG0));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_ADDR_L    [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_ADDR_L, _reg_read(reg_base + TDE_REG_SRC_SURFACE_ADDR_L));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_ADDR_H    [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_ADDR_H, _reg_read(reg_base + TDE_REG_SRC_SURFACE_ADDR_H));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_PIXEL_4B  [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_PIXEL_4B, _reg_read(reg_base + TDE_REG_SRC_SURFACE_PIXEL_4B));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_PIXEL_2B  [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_PIXEL_2B, _reg_read(reg_base + TDE_REG_SRC_SURFACE_PIXEL_2B));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_STRIDE    [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_STRIDE, _reg_read(reg_base + TDE_REG_SRC_SURFACE_STRIDE));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_WIDTH     [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_WIDTH, _reg_read(reg_base + TDE_REG_SRC_SURFACE_WIDTH));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_HEIGHT    [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_HEIGHT, _reg_read(reg_base + TDE_REG_SRC_SURFACE_HEIGHT));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_ADDR_L    [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_ADDR_L, _reg_read(reg_base + TDE_REG_DST_SURFACE_ADDR_L));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_ADDR_H    [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_ADDR_H, _reg_read(reg_base + TDE_REG_DST_SURFACE_ADDR_H));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_WIDTH     [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_WIDTH, _reg_read(reg_base + TDE_REG_DST_SURFACE_WIDTH));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_HEIGHT    [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_HEIGHT, _reg_read(reg_base + TDE_REG_DST_SURFACE_HEIGHT));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_STRIDE    [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_STRIDE, _reg_read(reg_base + TDE_REG_DST_SURFACE_STRIDE));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL0       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL0, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL0));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL1       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL1, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL1));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL2       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL2, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL2));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL3       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL3, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL3));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL4       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL4, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL4));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL5       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL5, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL5));
+	TRACE_TDE(DBG_ERR, "SHADOW_RD_SEL         [0x%02x]: 0x%08x\n",
+		TDE_REG_SHADOW_RD_SEL, _reg_read(reg_base + TDE_REG_SHADOW_RD_SEL));
+	TRACE_TDE(DBG_ERR, "START_CTRL            [0x%02x]: 0x%08x\n",
+		TDE_REG_START_CTRL, _reg_read(reg_base + TDE_REG_START_CTRL));
+	TRACE_TDE(DBG_ERR, "DBG_BUS               [0x%02x]: 0x%08x\n",
+		TDE_REG_DBG_BUS, _reg_read(reg_base + TDE_REG_DBG_BUS));
+	TRACE_TDE(DBG_ERR, "CLK_GATE              [0x%02x]: 0x%08x\n",
+		TDE_REG_CLK_GATE, _reg_read(reg_base + TDE_REG_CLK_GATE));
+	TRACE_TDE(DBG_ERR, "INTR_STATUS           [0x%02x]: 0x%08x\n",
+		TDE_REG_INTR_STATUS, _reg_read(reg_base + TDE_REG_INTR_STATUS));
+	TRACE_TDE(DBG_ERR, "INTR_CLEAR            [0x%02x]: 0x%08x\n",
+		TDE_REG_INTR_CLEAR, _reg_read(reg_base + TDE_REG_INTR_CLEAR));
+	TRACE_TDE(DBG_ERR, "BW_LIMIT_RD           [0x%02x]: 0x%08x\n",
+		TDE_REG_BW_LIMIT_RD, _reg_read(reg_base + TDE_REG_BW_LIMIT_RD));
+	TRACE_TDE(DBG_ERR, "BW_LIMIT_WR           [0x%02x]: 0x%08x\n",
+		TDE_REG_BW_LIMIT_WR, _reg_read(reg_base + TDE_REG_BW_LIMIT_WR));
+}
 
diff --git a/interdrv/tde/chip/cv184x/tde_reg.h b/interdrv/tde/chip/cv184x/tde_reg.h
index cd74df91..ed338893 100644
--- a/interdrv/tde/chip/cv184x/tde_reg.h
+++ b/interdrv/tde/chip/cv184x/tde_reg.h
@@ -39,4 +39,6 @@ u32 tde_intr_status(void);
 void tde_clear_intr(void);
 void tde_toggle_reset(void);
 
+void tde_dump_reg(void);
+
 #endif
diff --git a/interdrv/tde/driver/tde_core.c b/interdrv/tde/driver/tde_core.c
index 16c3a212..1680a156 100644
--- a/interdrv/tde/driver/tde_core.c
+++ b/interdrv/tde/driver/tde_core.c
@@ -3,18 +3,37 @@
 #include "tde_ip_ctrl.h"
 #include "base_ctx.h"
 
-static void _tde_remove_task(struct tde_job *job)
+static void _tde_status(struct tde_job *job)
 {
 	struct tde_task *task;
+	int idx = 0;
+
+	TRACE_TDE(DBG_ERR, "===== job status =====\n");
+	TRACE_TDE(DBG_ERR, "hdl(%d), task_cnt(%d), is_sync(%d), is_block(%d)\n",
+		job->hdl, osal_atomic_read(&job->task_cnt), job->is_sync, job->is_block);
 
 	osal_mutex_lock(&job->lock);
-	while (!osal_list_empty(&job->task_list)) {
-		task = osal_list_first_entry(&job->task_list,
-			struct tde_task, item);
-		osal_list_del_init(&task->item);
-		osal_vfree(task);
+	osal_list_for_each_entry(task, &job->task_list, item) {
+		TRACE_TDE(DBG_ERR, "pending task[%d]: mode(%d)\n", idx, task->mode);
+		TRACE_TDE(DBG_ERR, "  src: w(%d) h(%d) stride(%d) addr(%llx) fmt(%d)\n",
+			task->src.width, task->src.height, task->src.stride,
+			task->src.phy_addr, task->src.color_fmt);
+		TRACE_TDE(DBG_ERR, "  dst: w(%d) h(%d) stride(%d) addr(%llx) fmt(%d)\n",
+			task->dst.width, task->dst.height, task->dst.stride,
+			task->dst.phy_addr, task->dst.color_fmt);
+		if (task->mode == TDE_TASK_DRAW_LINE) {
+			TRACE_TDE(DBG_ERR, "  line: start(%d,%d) end(%d,%d) color(%x) thick(%d)\n",
+				task->line.start_x, task->line.start_y,
+				task->line.end_x, task->line.end_y,
+				task->line.color, task->line.thick);
+		}
+		idx++;
 	}
 	osal_mutex_unlock(&job->lock);
+
+	TRACE_TDE(DBG_ERR, "pending task count in list(%d)\n", idx);
+
+	tde_ip_dump_status();
 }
 
 static void _tde_task_run(struct tde_task *task)
@@ -61,21 +80,23 @@ static void _tde_job_process(struct tde_job *job, osal_semaphore *sem)
 		osal_mutex_lock(&job->lock);
 		task = osal_list_first_entry(&job->task_list,
 			struct tde_task, item);
-		osal_list_del_init(&task->item);
 		osal_mutex_unlock(&job->lock);
 
 		_tde_task_run(task);
 		TRACE_TDE(DBG_INFO, "***running task(%d), handle(%d)***.\n", task->mode, job->hdl);
 
-		osal_vfree(task);
 		ret = osal_sem_down_timeout(sem, timeout);
 		if (ret != OSAL_SUCCESS) {
 			TRACE_TDE(DBG_ERR, "TDE timeout, HW hang.\n");
+			_tde_status(job);
 			tde_ip_reset();
-			_tde_remove_task(job);
-			break;
+			continue;
 		}
 
+		osal_mutex_lock(&job->lock);
+		osal_list_del_init(&task->item);
+		osal_mutex_unlock(&job->lock);
+		osal_vfree(task);
 		osal_atomic_dec(&job->task_cnt);
 	}
 
@@ -175,6 +196,7 @@ int tde_core_open(struct tde_core *core)
 	osal_clk_prepare_enable(core->clk);
 	tde_ip_init();
 	osal_clk_disable(core->clk);
+
 	return 0;
 }
 
@@ -184,8 +206,9 @@ int tde_core_release(struct tde_core *core)
 		osal_msleep(1);
 	}
 
+	osal_clk_enable(core->clk);
 	tde_ip_deinit();
-	osal_clk_unprepare(core->clk);
+	osal_clk_disable_unprepare(core->clk);
 
 	return 0;
 }
diff --git a/interdrv/tde/platform/linux/tde_dev.c b/interdrv/tde/platform/linux/tde_dev.c
index 193ff81d..030a2b26 100644
--- a/interdrv/tde/platform/linux/tde_dev.c
+++ b/interdrv/tde/platform/linux/tde_dev.c
@@ -35,18 +35,16 @@ static int tde_exec_cb(void *dev, cb_modules_id caller, unsigned int cmd, void *
 	struct tde_inter_cfg *cfg;
 	int rc = -1;
 
+	if (osal_atomic_inc_return(&dev_data->open_count) == 1)
+		tde_core_open(&dev_data->core);
+
 	switch (cmd) {
 		case TDE_CB_OP: {
 			cfg = (struct tde_inter_cfg *)arg;
-
-			if (osal_atomic_inc_return(&dev_data->open_count) == 1)
-				tde_core_open(&dev_data->core);
 			rc = tde_do_op(&dev_data->core, cfg->usage, cfg->usage_param
 				, cfg->width, cfg->height, cfg->src_addr
 				, cfg->dst_addr, cfg->sync_io, cfg->block
 				, (enum tde_task_mode_e)cfg->task_mode);
-			if (osal_atomic_dec_return(&dev_data->open_count) == 0)
-				tde_core_release(&dev_data->core);
 			break;
 		}
 		default: {
@@ -55,6 +53,9 @@ static int tde_exec_cb(void *dev, cb_modules_id caller, unsigned int cmd, void *
 		}
 	}
 
+	if (osal_atomic_dec_return(&dev_data->open_count) == 0)
+		tde_core_release(&dev_data->core);
+
 	return rc;
 }
 
