diff --git a/interdrv/tde/driver/tde_core.c b/interdrv/tde/driver/tde_core.c
index 16c3a212..d5d2bf10 100644
--- a/interdrv/tde/driver/tde_core.c
+++ b/interdrv/tde/driver/tde_core.c
@@ -3,6 +3,39 @@
 #include "tde_ip_ctrl.h"
 #include "base_ctx.h"
 
+static void _tde_status(struct tde_job *job)
+{
+	struct tde_task *task;
+	int idx = 0;
+
+	TRACE_TDE(DBG_ERR, "===== job status =====\n");
+	TRACE_TDE(DBG_ERR, "hdl(%d), task_cnt(%d), is_sync(%d), is_block(%d)\n",
+		job->hdl, osal_atomic_read(&job->task_cnt), job->is_sync, job->is_block);
+
+	osal_mutex_lock(&job->lock);
+	osal_list_for_each_entry(task, &job->task_list, item) {
+		TRACE_TDE(DBG_ERR, "pending task[%d]: mode(%d)\n", idx, task->mode);
+		TRACE_TDE(DBG_ERR, "  src: w(%d) h(%d) stride(%d) addr(%llx) fmt(%d)\n",
+			task->src.width, task->src.height, task->src.stride,
+			task->src.phy_addr, task->src.color_fmt);
+		TRACE_TDE(DBG_ERR, "  dst: w(%d) h(%d) stride(%d) addr(%llx) fmt(%d)\n",
+			task->dst.width, task->dst.height, task->dst.stride,
+			task->dst.phy_addr, task->dst.color_fmt);
+		if (task->mode == TDE_TASK_DRAW_LINE) {
+			TRACE_TDE(DBG_ERR, "  line: start(%d,%d) end(%d,%d) color(%x) thick(%d)\n",
+				task->line.start_x, task->line.start_y,
+				task->line.end_x, task->line.end_y,
+				task->line.color, task->line.thick);
+		}
+		idx++;
+	}
+	osal_mutex_unlock(&job->lock);
+
+	TRACE_TDE(DBG_ERR, "pending task count in list(%d)\n", idx);
+
+	tde_ip_dump_status();
+}
+
 static void _tde_remove_task(struct tde_job *job)
 {
 	struct tde_task *task;
@@ -71,6 +104,7 @@ static void _tde_job_process(struct tde_job *job, osal_semaphore *sem)
 		ret = osal_sem_down_timeout(sem, timeout);
 		if (ret != OSAL_SUCCESS) {
 			TRACE_TDE(DBG_ERR, "TDE timeout, HW hang.\n");
+			_tde_status(job);
 			tde_ip_reset();
 			_tde_remove_task(job);
 			break;
@@ -117,9 +151,7 @@ static int tde_event_handler(void *arg)
 		osal_list_del_init(&job->item);
 		osal_spin_unlock(&core->lock);
 
-		osal_clk_enable(core->clk);
 		_tde_job_process(job, &core->sem_intr);
-		osal_clk_disable(core->clk);
 
 		osal_atomic_dec(&core->job_num);
 	}
@@ -147,6 +179,8 @@ int tde_core_init(struct tde_core *core)
 		return -1;
 	}
 	osal_kthread_set_priority(core->thread, MM_THREAD_PRIO);
+	osal_clk_prepare_enable(core->clk);
+	tde_ip_init();
 
 	return 0;
 }
@@ -167,14 +201,14 @@ int tde_core_deinit(struct tde_core *core)
 	osal_sem_destroy(&core->sem_job);
 	osal_sem_destroy(&core->sem_intr);
 
+	tde_ip_deinit();
+	osal_clk_disable_unprepare(core->clk);
+
 	return 0;
 }
 
 int tde_core_open(struct tde_core *core)
 {
-	osal_clk_prepare_enable(core->clk);
-	tde_ip_init();
-	osal_clk_disable(core->clk);
 	return 0;
 }
 
@@ -184,9 +218,6 @@ int tde_core_release(struct tde_core *core)
 		osal_msleep(1);
 	}
 
-	tde_ip_deinit();
-	osal_clk_unprepare(core->clk);
-
 	return 0;
 }
 
