@@ -97,4 +97,115 @@ void tde_toggle_reset(void)
 	osal_iounmap(vi_sys_addr, 4);
 }
 
+u32 read_isp_top_clk(void)
+{
+	void *clk_addr = NULL;
+	u32 mask = BIT(9);
+	u32 value;
+
+	clk_addr = osal_ioremap((unsigned long)0x30020f0, 4);
+	if (!clk_addr) {
+		TRACE_TDE(DBG_ERR, "osal_ioremap fail.\n");
+		return 0;
+	}
+
+	value = _reg_read((uintptr_t)clk_addr);
+	osal_iounmap(clk_addr, 4);
+
+	return value & mask;
+}
+
+u32 read_isp_top_dbus(void)
+{
+	void *isp_top_addr = NULL;
+	u32 value;
+
+	isp_top_addr = osal_ioremap((unsigned long)0x0a070040, 0x20);
+	if (!isp_top_addr) {
+		TRACE_TDE(DBG_ERR, "osal_ioremap fail.\n");
+		return 0;
+	}
+
+	value = _reg_read((uintptr_t)isp_top_addr);
+	TRACE_TDE(DBG_ERR, "isp top reg_dbus0 : %0xx\n", value);
+
+	value = _reg_read((uintptr_t)isp_top_addr + 0x4);
+	TRACE_TDE(DBG_ERR, "isp top reg_dbus1 : %0xx\n", value);
+
+	value = _reg_read((uintptr_t)isp_top_addr + 0x8);
+	TRACE_TDE(DBG_ERR, "isp top reg_dbus2 : %0xx\n", value);
+
+	value = _reg_read((uintptr_t)isp_top_addr + 0xc);
+	TRACE_TDE(DBG_ERR, "isp top reg_dbus3 : %0xx\n", value);
+
+	value = _reg_read((uintptr_t)isp_top_addr + 0x18);
+	TRACE_TDE(DBG_ERR, "isp top reg_dbus4 : %0xx\n", value);
+
+	osal_iounmap(isp_top_addr, 0x20);
+
+	return 0;
+}
+
+void tde_dump_reg(void)
+{
+	TRACE_TDE(DBG_ERR, "===== TDE reg dump =====\n");
+	TRACE_TDE(DBG_ERR, "SURFACE_REG0          [0x%02x]: 0x%08x\n",
+		TDE_REG_SURFACE_REG0, _reg_read(reg_base + TDE_REG_SURFACE_REG0));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_ADDR_L    [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_ADDR_L, _reg_read(reg_base + TDE_REG_SRC_SURFACE_ADDR_L));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_ADDR_H    [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_ADDR_H, _reg_read(reg_base + TDE_REG_SRC_SURFACE_ADDR_H));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_PIXEL_4B  [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_PIXEL_4B, _reg_read(reg_base + TDE_REG_SRC_SURFACE_PIXEL_4B));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_PIXEL_2B  [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_PIXEL_2B, _reg_read(reg_base + TDE_REG_SRC_SURFACE_PIXEL_2B));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_STRIDE    [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_STRIDE, _reg_read(reg_base + TDE_REG_SRC_SURFACE_STRIDE));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_WIDTH     [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_WIDTH, _reg_read(reg_base + TDE_REG_SRC_SURFACE_WIDTH));
+	TRACE_TDE(DBG_ERR, "SRC_SURFACE_HEIGHT    [0x%02x]: 0x%08x\n",
+		TDE_REG_SRC_SURFACE_HEIGHT, _reg_read(reg_base + TDE_REG_SRC_SURFACE_HEIGHT));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_ADDR_L    [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_ADDR_L, _reg_read(reg_base + TDE_REG_DST_SURFACE_ADDR_L));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_ADDR_H    [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_ADDR_H, _reg_read(reg_base + TDE_REG_DST_SURFACE_ADDR_H));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_WIDTH     [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_WIDTH, _reg_read(reg_base + TDE_REG_DST_SURFACE_WIDTH));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_HEIGHT    [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_HEIGHT, _reg_read(reg_base + TDE_REG_DST_SURFACE_HEIGHT));
+	TRACE_TDE(DBG_ERR, "DST_SURFACE_STRIDE    [0x%02x]: 0x%08x\n",
+		TDE_REG_DST_SURFACE_STRIDE, _reg_read(reg_base + TDE_REG_DST_SURFACE_STRIDE));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL0       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL0, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL0));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL1       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL1, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL1));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL2       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL2, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL2));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL3       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL3, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL3));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL4       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL4, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL4));
+	TRACE_TDE(DBG_ERR, "DRAW_LINE_CTRL5       [0x%02x]: 0x%08x\n",
+		TDE_REG_DRAW_LINE_CTRL5, _reg_read(reg_base + TDE_REG_DRAW_LINE_CTRL5));
+	TRACE_TDE(DBG_ERR, "SHADOW_RD_SEL         [0x%02x]: 0x%08x\n",
+		TDE_REG_SHADOW_RD_SEL, _reg_read(reg_base + TDE_REG_SHADOW_RD_SEL));
+	TRACE_TDE(DBG_ERR, "START_CTRL            [0x%02x]: 0x%08x\n",
+		TDE_REG_START_CTRL, _reg_read(reg_base + TDE_REG_START_CTRL));
+	TRACE_TDE(DBG_ERR, "DBG_BUS               [0x%02x]: 0x%08x\n",
+		TDE_REG_DBG_BUS, _reg_read(reg_base + TDE_REG_DBG_BUS));
+	TRACE_TDE(DBG_ERR, "CLK_GATE              [0x%02x]: 0x%08x\n",
+		TDE_REG_CLK_GATE, _reg_read(reg_base + TDE_REG_CLK_GATE));
+	TRACE_TDE(DBG_ERR, "INTR_STATUS           [0x%02x]: 0x%08x\n",
+		TDE_REG_INTR_STATUS, _reg_read(reg_base + TDE_REG_INTR_STATUS));
+	TRACE_TDE(DBG_ERR, "INTR_CLEAR            [0x%02x]: 0x%08x\n",
+		TDE_REG_INTR_CLEAR, _reg_read(reg_base + TDE_REG_INTR_CLEAR));
+	TRACE_TDE(DBG_ERR, "BW_LIMIT_RD           [0x%02x]: 0x%08x\n",
+		TDE_REG_BW_LIMIT_RD, _reg_read(reg_base + TDE_REG_BW_LIMIT_RD));
+	TRACE_TDE(DBG_ERR, "BW_LIMIT_WR           [0x%02x]: 0x%08x\n",
+		TDE_REG_BW_LIMIT_WR, _reg_read(reg_base + TDE_REG_BW_LIMIT_WR));
+
+	TRACE_TDE(DBG_ERR, "---isp top clk is %s.\n", read_isp_top_clk() ? "open" : "close");
+	read_isp_top_dbus();
+}
+
 
