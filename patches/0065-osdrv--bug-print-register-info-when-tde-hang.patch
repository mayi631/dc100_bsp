index f5b69874..93827805 100644
--- a/interdrv/tde/platform/linux/tde_proc.c
+++ b/interdrv/tde/platform/linux/tde_proc.c
@@ -5,6 +5,7 @@
 
 #include "tde_debug.h"
 #include "tde_core.h"
+#include "tde_ip_ctrl.h"
 
 
 #define TDE_PROC_NAME          "soph/tde"
@@ -18,7 +19,7 @@ static int proc_tde_mode;
 
 int tde_ctx_proc_show(struct seq_file *m, void *v)
 {
-	//todo
+	tde_ip_dump_status();
 	return 0;
 }
 
