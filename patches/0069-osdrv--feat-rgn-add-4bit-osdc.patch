From 2710a8c705bb9ba4df15307efbddf799093b6e6f Mon Sep 17 00:00:00 2001
From: "xuyang.he" <xuyang.he@sophgo.com>
Date: Tue, 3 Feb 2026 13:48:43 +0800
Subject: [PATCH 69/84] [feat][rgn]:add 4bit osdc

Change-Id: I0608d50b95c279a4dcdc5c3612ba4a02196e9af8
---
 interdrv/rgn/driver/rgn.c                   | 7 +++++++
 interdrv/rgn/platform/alios/proc/rgn_proc.c | 3 +++
 interdrv/rgn/platform/linux/proc/rgn_proc.c | 3 +++
 interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c    | 7 ++++++-
 4 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/interdrv/rgn/driver/rgn.c b/interdrv/rgn/driver/rgn.c
index bfc75635..f48262f7 100644
--- a/interdrv/rgn/driver/rgn.c
+++ b/interdrv/rgn/driver/rgn.c
@@ -195,6 +195,9 @@ static inline int _rgn_get_bytesperline(pixel_format_e pixel_format, unsigned in
 	case PIXEL_FORMAT_8BIT_MODE:
 		*bytesperline = width;
 		break;
+	case PIXEL_FORMAT_4BIT_MODE:
+		*bytesperline = width >> 1;
+		break;
 	case PIXEL_FORMAT_FONT:
 		*bytesperline = (width + 7) >> 3;
 		break;
@@ -633,6 +636,9 @@ static int _rgn_set_hw_cfg(rgn_handle hdls[], unsigned char size, mmf_chn_s *pch
 		case PIXEL_FORMAT_8BIT_MODE:
 			cfg.param[rgn_idx].fmt = RGN_FMT_256LUT;
 			break;
+		case PIXEL_FORMAT_4BIT_MODE:
+			cfg.param[rgn_idx].fmt = RGN_FMT_16LUT;
+			break;
 		case PIXEL_FORMAT_FONT:
 			cfg.param[rgn_idx].fmt = RGN_FMT_FONT;
 			cfg.invert_param[j].rgn_idx = rgn_idx;
@@ -1238,6 +1244,7 @@ int rgn_create(rgn_handle handle, const rgn_attr_s *pregion)
 		if ((pixel_format != PIXEL_FORMAT_ARGB_8888)
 		 && (pixel_format != PIXEL_FORMAT_ARGB_4444)
 		 && (pixel_format != PIXEL_FORMAT_ARGB_1555)
+		 && (pixel_format != PIXEL_FORMAT_4BIT_MODE)
 		 && (pixel_format != PIXEL_FORMAT_8BIT_MODE)
 		 && (pixel_format != PIXEL_FORMAT_FONT)) {
 			TRACE_RGN(RGN_ERR, "unsupported pxl-fmt(%d).\n", pixel_format);
diff --git a/interdrv/rgn/platform/alios/proc/rgn_proc.c b/interdrv/rgn/platform/alios/proc/rgn_proc.c
index 299e8da2..b928c983 100644
--- a/interdrv/rgn/platform/alios/proc/rgn_proc.c
+++ b/interdrv/rgn/platform/alios/proc/rgn_proc.c
@@ -18,6 +18,9 @@ static void _pix_fmt_to_string(enum _pixel_format_e pix_fmt, char *str, int len)
 	case PIXEL_FORMAT_8BIT_MODE:
 		strncpy(str, "256LUT", len);
 		break;
+	case PIXEL_FORMAT_4BIT_MODE:
+		strncpy(str, "16LUT", len);
+		break;
 	case PIXEL_FORMAT_ARGB_1555:
 		strncpy(str, "ARGB_1555", len);
 		break;
diff --git a/interdrv/rgn/platform/linux/proc/rgn_proc.c b/interdrv/rgn/platform/linux/proc/rgn_proc.c
index 2e3f50d6..7eb973a7 100644
--- a/interdrv/rgn/platform/linux/proc/rgn_proc.c
+++ b/interdrv/rgn/platform/linux/proc/rgn_proc.c
@@ -15,6 +15,9 @@ static void _pix_fmt_to_string(enum _pixel_format_e pix_fmt, char *str, int len)
 	case PIXEL_FORMAT_8BIT_MODE:
 		strncpy(str, "256LUT", len);
 		break;
+	case PIXEL_FORMAT_4BIT_MODE:
+		strncpy(str, "16LUT", len);
+		break;
 	case PIXEL_FORMAT_ARGB_1555:
 		strncpy(str, "ARGB_1555", len);
 		break;
diff --git a/interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c b/interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c
index eeb2c46c..e5586762 100644
--- a/interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c
+++ b/interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c
@@ -116,7 +116,12 @@ int _sc_ext_set_rgn_cfg(const u8 inst, u8 layer, const struct rgn_cfg *rgn_cfg,
 	gop_cfg->colorkey = rgn_cfg->colorkey;
 
 	if (rgn_lut_cfg->is_updated) {
-		sclr_gop_setup_256LUT(inst, layer, rgn_lut_cfg->lut_length, rgn_lut_cfg->lut_addr);
+		if (rgn_lut_cfg->lut_length > 16){
+			sclr_gop_setup_256LUT(inst, layer, rgn_lut_cfg->lut_length, rgn_lut_cfg->lut_addr);
+		}
+		else{
+			sclr_gop_setup_16LUT(inst, layer, rgn_lut_cfg->lut_length, rgn_lut_cfg->lut_addr);
+		}
 	}
 
 	if (rgn_cfg->odec.enable) { // odec enable
-- 
