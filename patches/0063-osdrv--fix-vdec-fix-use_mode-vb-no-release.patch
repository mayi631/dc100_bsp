From: "siyong.chen" <siyong.chen@sophgo.com>
Date: Thu, 23 Apr 2026 14:43:43 +0800
Subject: [PATCH 63/84] [fix](vdec):fix use_mode vb no release

[description]:NA
[root cause]:NA
[JIRA ID]:CV184XSDK-1211
[chip project]:CV184X
[side effects]:NA
[Affected *.ko/*.so/*.a] :NA

Signed-off-by: siyong.chen <siyong.chen@sophgo.com>
Change-Id: I0d2b140df2a3b926704171e16de30dd994cc48ed
---
 interdrv/vc_drv/driver/vdec.c | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/interdrv/vc_drv/driver/vdec.c b/interdrv/vc_drv/driver/vdec.c
index 66a14083..f2f2b71e 100644
--- a/interdrv/vc_drv/driver/vdec.c
+++ b/interdrv/vc_drv/driver/vdec.c
@@ -831,15 +831,12 @@ static void get_debug_config_from_proc(void)
 #endif
 
 
-static int free_vdec_frame(vdec_chn_attr_s *pst_attr,
-				   video_frame_info_s *pst_video_frame)
+static int free_vdec_frame(vdec_chn_attr_s *pst_attr, uint64_t u64_phy_addr)
 {
-	video_frame_s *pst_vframe = &pst_video_frame->video_frame;
-
 	vb_blk blk;
 
 	if (pst_attr->en_type == PT_JPEG || pst_attr->en_type == PT_MJPEG) {
-		blk = vb_phys_addr2handle(pst_vframe->phyaddr[0]);
+		blk = vb_phys_addr2handle(u64_phy_addr);
 		if (blk != VB_INVALID_HANDLE) {
 			vb_release_block(blk);
 		}
@@ -1503,7 +1500,7 @@ int drv_vdec_stop_recv_stream(vdec_chn vd_chn)
 				 i++) {
 				ret = free_vdec_frame(
 					&p_chn_handle->chn_attr,
-					&p_chn_handle->video_frame_array[i]);
+					p_chn_handle->frm_array[i].phy_addr);
 				if (ret != 0) {
 					DRV_VDEC_ERR("free_vdec_frame, %ud\n",
 							 ret);
