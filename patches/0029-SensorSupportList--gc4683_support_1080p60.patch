 #define GC4683_RES_IS_1440P(w, h)      ((w) <= 2560 && (h) <= 1440)
 #define GC4683_RES_IS_720P(w, h)      ((w) == 1280 && (h) == 720)
+#define GC4683_RES_IS_1080P(w, h)	 ((w) == 1920 && (h) == 1080)
 
