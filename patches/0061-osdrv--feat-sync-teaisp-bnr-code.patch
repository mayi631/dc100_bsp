 				continue;
 			}
 			out_buf->ai_cfg = ctx->isp_csi_cfg[raw_num].ai_cfg;
-			out_buf->tv = in_buf->tv;
-			out_buf->frm_num = in_buf->frm_num;
+			out_buf->tv = tv;
+			out_buf->frm_num = frm_num;
 			isp_buf_queue(post_in_q, out_buf);
 		}
 		fe_chn++;
 	}
 
-	_vi_wake_up_post_th(vdev);
+	if (ctx->is_rawreplay) {
