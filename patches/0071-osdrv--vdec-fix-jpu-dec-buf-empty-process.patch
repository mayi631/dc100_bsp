@@ -1465,20 +1467,20 @@ static void setup_frame_info(struct hal_jpegd_ctx_s *ctx, struct hal_dec_task_s
 		task->frame_cfg->length[2] = width_aglin * height_align;
 		break;
 	case JPEG_FORMAT_444:
-		task->frame_cfg->addr[1] = ctx->frame_buf.ptr + width_aglin * height_align;
+		task->frame_cfg->addr[1] = task->frame_cfg->addr[0] + width_aglin * height_align;
 		task->frame_cfg->addr[2] = task->frame_cfg->addr[1] + width_aglin * height_align;
 
-		task->frame_cfg->phy_addr[1] = ctx->frame_buf.phy_addr + width_aglin * height_align;
+		task->frame_cfg->phy_addr[1] = task->frame_cfg->phy_addr[0] + width_aglin * height_align;
 		task->frame_cfg->phy_addr[2] = task->frame_cfg->phy_addr[1] + width_aglin * height_align;
 		task->frame_cfg->length[0] = width_aglin * height_align;
 		task->frame_cfg->length[1] = width_aglin * height_align;
 		task->frame_cfg->length[2] = width_aglin * height_align;
 		break;
 	case JPEG_FORMAT_400:
-		task->frame_cfg->addr[1] = ctx->frame_buf.ptr;
+		task->frame_cfg->addr[1] = task->frame_cfg->addr[0];
 		task->frame_cfg->addr[2] = task->frame_cfg->addr[1];
 
-		task->frame_cfg->phy_addr[1] = ctx->frame_buf.phy_addr;
+		task->frame_cfg->phy_addr[1] = task->frame_cfg->phy_addr[0];
 		task->frame_cfg->phy_addr[2] = task->frame_cfg->phy_addr[1];
 		task->frame_cfg->length[0] = width_aglin * height_align;
 		task->frame_cfg->length[1] = 0;
@@ -1543,6 +1545,7 @@ enum vc_ret_e hal_jpegd_gen_regs(void *hal, struct hal_dec_task_s *task)
 		return VC_ERR_VALUE;
 	}
 
+	if (!task->use_vb_pool) {
 	if (ctx->frame_buf.phy_addr == 0) {
 		if (vc_buffer_alloc(NULL, &ctx->frame_buf,
 			get_frame_buffer_size(dec_info), "frame_buf")) {
@@ -1564,6 +1567,7 @@ enum vc_ret_e hal_jpegd_gen_regs(void *hal, struct hal_dec_task_s *task)
 			get_frame_buffer_size(dec_info), "frame_buf")) {
 			vc_err("Failed to allocate frm buffer\n");
 			return VC_ERR_MALLOC;
+			}
 		}
 	}
 	setup_frame_info(ctx, task);
@@ -1830,6 +1834,7 @@ enum vc_ret_e hal_jpegd_start(void *hal, struct hal_dec_task_s *task)
 					0x0 + 100, sizeof(VC_JPEG_GBU_C));
 	vc_add_reg_wr_cfg(ctx->dev, &wr_cfg, JPU_CLASS_MC, &reg->vc_jpeg_mc_reg,
 					0x0, sizeof(VC_JPEG_MC_C));
+	if (dec_info->use_hufftab)
 	vc_add_reg_wr_cfg(ctx->dev, &wr_cfg, JPU_CLASS_HUFF, &reg->vc_jpeg_huff_reg,
 					0x0 + 80, (ctx->huff_tab_size + 2) * sizeof(int));
 	vc_add_reg_wr_cfg(ctx->dev, &wr_cfg, JPU_CLASS_QMAT, &reg->vc_jpeg_qmat_reg,
diff --git a/interdrv/vc_drv/driver/dec_api/jpeg_dec_api.c b/interdrv/vc_drv/driver/dec_api/jpeg_dec_api.c
