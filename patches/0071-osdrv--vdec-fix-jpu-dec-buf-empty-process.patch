 		task->frame_cfg->length[0] = width_aglin * height_align;
 		if (dec_info->chroma_interleave) {
@@ -1435,10 +1437,10 @@ static void setup_frame_info(struct hal_jpegd_ctx_s *ctx, struct hal_dec_task_s
 		}
 		break;
 	case JPEG_FORMAT_422:
