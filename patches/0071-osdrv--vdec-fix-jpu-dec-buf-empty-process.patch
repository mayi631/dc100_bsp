diff --git a/interdrv/vc_drv/driver/vpu_srv/jpu.c b/interdrv/vc_drv/driver/vpu_srv/jpu.c
index 354efa52..dbedb5a0 100644
--- a/interdrv/vc_drv/driver/vpu_srv/jpu.c
+++ b/interdrv/vc_drv/driver/vpu_srv/jpu.c
@@ -664,10 +664,11 @@ static int jpu_run(struct vpu_dev *vpu, struct vpu_task *vpu_task)
 	}
 
 	flush_reg();
-
+	osal_spin_lock(&vpu->dev_spin_lock);
+	vpu->cur_task = vpu_task;
+	osal_spin_unlock(&vpu->dev_spin_lock);
 	vpu_write_relaxed(vpu, REG_JPEG_PIC_START, start_val);
 	/* init current task */
-	vpu->cur_task = vpu_task;
 	vpu_debug_leave();
 	return 0;
 }
@@ -688,18 +689,44 @@ static int jpu_isr(struct vpu_dev *vpu)
 {
 	struct jpu_task *task = NULL;
 	struct vpu_task *vpu_task = vpu->cur_task;
+	int client_type;
 
+	client_type = (enum VPU_CLIENT_TYPE)vpu_task->session->client_type;
 	if (!vpu_task)
 		return OSAL_IRQ_HANDLED;
 	vpu_time_diff(vpu_task, "jpu_done");
 	task = to_jpu_task(vpu_task);
 	task->irq_status = vpu->irq_status;
 	if (task->irq_status & (1 << INT_JPEG_DONE)) {
-		vpu->cur_task = NULL;
 		vpu_write_relaxed(vpu, REG_JPEG_PIC_STATUS, vpu->irq_status);
 		vpu_task_finish(vpu_task->session, vpu_task);
 		return OSAL_IRQ_WAKE_THREAD;
 	}
+	if (client_type == VPU_CLIENT_JPU_DEC) {
+		vpu_log("jpeg irq status: 0x%x\n", task->irq_status);
+		if (task->irq_status & (1 << INT_JPEG_BIT_BUF_EMPTY)) {
+			u32 stream_start_addr;
+			u32 stream_wr_ptr;
+			u32 val;
+
+			stream_start_addr = vpu_read_relaxed(vpu, REG_JPEG_BBC_BAS_ADDR);
+			stream_wr_ptr = vpu_read_relaxed(vpu, REG_JPEG_BBC_WR_PTR);
+			val = (stream_wr_ptr - stream_start_addr) / 256;
+			if((stream_wr_ptr - stream_start_addr) % 256) {
+				val = val + 1;
+			}
+			vpu_write_relaxed(vpu, REG_JPEG_BBC_STRM_CTRL_REG, (1 << 31 | val));
+			vpu_write_relaxed(vpu, REG_JPEG_PIC_STATUS, 1 << INT_JPEG_BIT_BUF_EMPTY);
+			vpu_write_relaxed(vpu, REG_JPEG_INTR_MASK, 0x0);
+			clear_bit(TASK_STATE_HANDLE, &vpu_task->state);
+			task->irq_status = 0;
+			return OSAL_IRQ_HANDLED;
+		}
+		vpu_task_finish(vpu_task->session, vpu_task);
+		jpu_sw_reset(vpu);
+		return OSAL_IRQ_WAKE_THREAD;
+	}
+
 	clear_bit(TASK_STATE_HANDLE, &vpu_task->state);
 	if (task->irq_status & (1 << INT_JPEG_BIT_BUF_FULL)) {
 		u64 stream_buf_start_addr = vpu_read_relaxed(vpu, REG_JPEG_BBC_BAS_ADDR);
@@ -913,4 +940,4 @@ int jpu_remove(struct vpu_dev *vpu)
 	vpu_dev_remove(&enc->vpu);
 	osal_vfree(enc);
 	return 0;
-}
