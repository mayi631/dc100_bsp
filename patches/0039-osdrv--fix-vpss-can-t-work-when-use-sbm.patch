+      osal_atomic_set(&core->state, VPSS_RUNNING);
+      core->start_cnt++;
+    } else {
+      osal_atomic_set(&core->state, VPSS_END);
+    }
 
-	return 0;
+    top_update(core->vpss_type, i < last_index, job->cfg.chn_enable[i]);
+  }
+
+  device->start_cnt++;
+  osal_atomic_set(&device->state, VPSS_RUNNING);
+  osal_atomic_set(&job->job_state, JOB_WORKING);
+  osal_gettimeofday(&device->ts_start);
+  osal_spin_unlock_irqrestore(&device->dev_lock, &flags);
+
+  TRACE_VPSS(DBG_INFO,
+             "Grp(%d) job working, chn enable(%d %d %d %d), dev(%d).\n",
+             job->grp_id, cfg->chn_enable[0], cfg->chn_enable[1],
+             cfg->chn_enable[2], cfg->chn_enable[3], device->id);
+
+  img_start(device->core_list[0]->vpss_type, device->core_num);
+
+  return 0;
 }
 
 static int notify_isp_retrigger(void)
@@ -338,14 +332,12 @@ int vpss_hal_try_schedule(struct vpss_hal_ctx *hal_ctx)
 			break;
 		}
 
-		osal_spin_lock_irqsave(&job->lock, &flags_job);
-		if (job_try_schedule(job, &cores->device[job->dev_id])) {
-			//TRACE_VPSS(DBG_DEBUG, "Grp(%d), try schedule fail, wait for next time.\n",
-			//	job->grp_id);
-			osal_spin_unlock_irqrestore(&job->lock, &flags_job);
-			break;
-		}
-		osal_list_del_init(&job->list);
+                osal_spin_lock_irqsave(&job->lock, &flags_job);
+                if (job_try_schedule(job, &cores->device[job->dev_id])) {
+                  osal_spin_unlock_irqrestore(&job->lock, &flags_job);
+                  break;
+                }
+                osal_list_del_init(&job->list);
 		osal_spin_unlock_irqrestore(&job->lock, &flags_job);
 		ret = 0;
 	}
diff --git a/interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c b/interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c
index eeb2c46c..d3c52905 100644
--- a/interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c
+++ b/interdrv/vpss/chip/cv184x/vpss_ip_ctrl.c
@@ -949,13 +949,15 @@ void vpss_interrupter_clear(u8 dev_idx, struct vpss_interrupter_status *status)
 
 	TRACE_VPSS(DBG_NOTICE, "vpss(%d), status(0x%x)\n", dev_idx, intr_status.raw);
 
-	if (intr_status.b.scl_frame_end == 1)
-		status->sc_end = true;
-
-	if (intr_status.b.cmdq_end == 1) {
-		status->cmdq_end = true;
-		sclr_clr_cmdq(dev_idx);
-	}
+        if (intr_status.b.scl_frame_end == 1)
+          status->sc_end = true;
+        if (intr_status.b.img_in_frame_end == 1)
+          status->img_end = true;
+
+        if (intr_status.b.cmdq_end == 1) {
+          status->cmdq_end = true;
+          sclr_clr_cmdq(dev_idx);
+        }
 }
 
