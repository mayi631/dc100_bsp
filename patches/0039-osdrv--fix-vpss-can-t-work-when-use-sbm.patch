 struct vpss_csc_matrix {
diff --git a/interdrv/vpss/driver/vpss_core.c b/interdrv/vpss/driver/vpss_core.c
index ff0006d4..38df4a82 100644
--- a/interdrv/vpss/driver/vpss_core.c
+++ b/interdrv/vpss/driver/vpss_core.c
@@ -151,13 +151,15 @@ static int _vpss_set_vc_sbm_done(int venc_chn, struct vpss_cores *cores)
 {
 	int vpss_sbm_index = 0;
 
-	TRACE_VPSS(DBG_DEBUG, "vc frame done.\n");
-
-	vpss_ip_reset(vpss_sbm_index, true, false);
-	cores->core[vpss_sbm_index].vc_sbm_done = 1;
-	osal_atomic_cmpxchg(&cores->core[vpss_sbm_index].state, VPSS_RUNNING, VPSS_END);
-	vpss_hal_job_finish((struct vpss_device *)cores->core[vpss_sbm_index].device);
-	return 0;
+        TRACE_VPSS(DBG_DEBUG, "vc frame done.\n");
+
+        cores->core[vpss_sbm_index].vc_sbm_done = 1;
+        cores->core[vpss_sbm_index].reset_sbm = 1;
+        osal_atomic_cmpxchg(&cores->core[vpss_sbm_index].state, VPSS_RUNNING,
+                            VPSS_END);
+        vpss_hal_job_finish(
+            (struct vpss_device *)cores->core[vpss_sbm_index].device);
+        return 0;
 }
 
 static void _vpss_set_mlv_info(unsigned char snr_num, struct mlv_i_s *p_m_lv_i)
@@ -821,14 +823,15 @@ void vpss_core_isr(int irq, void *data)
 	if (core->intr_status.cmdq_end) {
 		core->intr_status.cmdq_end = false;
 		vpss_cmdq_irq_handler(core);
-		return;
-	}
-
-	if (core->intr_status.sc_end) {
-		core->intr_status.sc_end = false;
-		core->checksum = vpss_get_checksum(vpss_idx);
-		vpss_irq_handler(core);
-	}
+                return;
+        }
+
+        if (core->intr_status.sc_end && core->intr_status.img_end) {
+          core->intr_status.sc_end = false;
+          core->intr_status.img_end = false;
+          core->checksum = vpss_get_checksum(vpss_idx);
+          vpss_irq_handler(core);
+        }
 }
 
 int vpss_core_suspend(struct vpss_cores *cores)
