From 255ba08e491b17e4f9f77b2c95e72eada20606de Mon Sep 17 00:00:00 2001
From: "yikai.zhang" <yikai.zhang@sophgo.com>
Date: Thu, 21 May 2026 18:16:06 +0800
Subject: [PATCH 79/84] add the rgn was destroyed after the vpss.

Change-Id: I7e95b0c6ab7f8fd0a1508c9c00fa3757a5d80d87
---
 interdrv/rgn/driver/rgn.c        | 78 ++++++++++++++++++++++++--------
 interdrv/vpss/driver/vpss_core.c | 68 ++++++++++++++++++++++++++++
 2 files changed, 126 insertions(+), 20 deletions(-)

diff --git a/interdrv/rgn/driver/rgn.c b/interdrv/rgn/driver/rgn.c
index 67cea793..3b0d7c10 100644
--- a/interdrv/rgn/driver/rgn.c
+++ b/interdrv/rgn/driver/rgn.c
@@ -108,6 +108,11 @@ static int _rgn_call_cb(unsigned int m_id, unsigned int cmd_id, void *data)
 	return base_exe_module_cb(&exe_cb);
 }
 
+static bool _rgn_cb_is_vpss_unavailable(int ret)
+{
+	return (ret == -1 || ret == ERR_VPSS_UNEXIST);
+}
+
 int32_t _rgn_init(void)
 {
 	rgn_hash = osal_hash_create(64);
@@ -964,6 +969,7 @@ static int _rgn_get_chn_info(struct rgn_ctx *ctx,
 	rgn_handle *hdls, unsigned char *size)
 {
 	struct _rgn_hdls_cb_param rgn_hdls_arg;
+	int ret;
 
 	rgn_hdls_arg.chn = ctx->chn;
 	rgn_hdls_arg.hdls = hdls;
@@ -985,9 +991,11 @@ static int _rgn_get_chn_info(struct rgn_ctx *ctx,
 			*size = RGN_MOSAIC_MAX_NUM;
 		}
 
-		if (_rgn_call_cb(E_MODULE_VPSS, VPSS_CB_GET_RGN_HDLS, &rgn_hdls_arg) != 0) {
-			TRACE_RGN(RGN_ERR, "VPSS_CB_GET_RGN_HDLS is failed\n");
-			return ERR_RGN_ILLEGAL_PARAM;
+		ret = _rgn_call_cb(E_MODULE_VPSS, VPSS_CB_GET_RGN_HDLS, &rgn_hdls_arg);
+		if (ret != 0) {
+			if (!_rgn_cb_is_vpss_unavailable(ret))
+				TRACE_RGN(RGN_ERR, "VPSS_CB_GET_RGN_HDLS is failed\n");
+			return ret;
 		}
 	} else {
 		return ERR_RGN_INVALID_DEVID;
@@ -1694,14 +1702,38 @@ RGN_FMT_INCORRECT:
 	return ret;
 }
 
+static void _rgn_free_canvas(struct rgn_ctx *ctx)
+{
+	unsigned char i;
+	unsigned char canvas_num = 1;
+
+	if (ctx->chn_attr.type == OVERLAY_RGN) {
+		canvas_num = ctx->region.unattr.overlay.canvas_num;
+	} else if (ctx->chn_attr.type == OVERLAYEX_RGN) {
+		canvas_num = ctx->region.unattr.overlay_ex.canvas_num;
+	}
+
+	for (i = 0; i < canvas_num; ++i) {
+		if (ctx->canvas_info[i].phy_addr)
+			base_ion_free(ctx->canvas_info[i].phy_addr);
+
+		ctx->canvas_info[i].phy_addr = 0;
+		ctx->canvas_info[i].virt_addr = NULL;
+	}
+
+	ctx->ion_len = 0;
+	ctx->max_need_ion = 0;
+}
+
 int rgn_detach_from_chn(rgn_handle handle, const mmf_chn_s *pchn)
 {
 	struct rgn_ctx *ctx = NULL;
 	int ret = OSAL_SUCCESS;
 	unsigned int proc_idx;
 	int ret_tmp;
-	unsigned char i;
 	struct _rgn_clr_ow_addr_cb_param cb_param;
+	bool vpss_available = true;
+	bool ow_inst_valid = false;
 
 	ret_tmp = check_rgn_handle(&ctx, handle);
 	if (ret_tmp != 0)
@@ -1717,28 +1749,28 @@ int rgn_detach_from_chn(rgn_handle handle, const mmf_chn_s *pchn)
 	osal_mutex_lock(&g_rgnlock);
 
 	ret = _rgn_update_hw(ctx, RGN_OP_REMOVE);
+	if (_rgn_cb_is_vpss_unavailable(ret)) {
+		TRACE_RGN(RGN_INFO, "VPSS is unavailable, detach rgn_handle(%d) locally.\n", handle);
+		vpss_available = false;
+		ret = OSAL_SUCCESS;
+	} else if (ret == 0) {
+		ow_inst_valid = true;
+	}
+
 	if (ret == 0) {
 		ctx->chn.mod_id = rgn_prc_ctx[proc_idx].chn.mod_id = ID_BASE;
 		rgn_prc_ctx[proc_idx].used = false;
 	}
 	ctx->odec_data_valid = false;
 
-	/*Waiting for the VPSS to truly close the RGN*/
-	osal_msleep(200);
-
-	if (ctx->chn_attr.type == OVERLAY_RGN) {
-		for (i = 0; i < ctx->region.unattr.overlay.canvas_num; ++i)
-			if (ctx->canvas_info[i].phy_addr)
-				base_ion_free(ctx->canvas_info[i].phy_addr);
-	} else if (ctx->chn_attr.type == OVERLAYEX_RGN) {
-		for (i = 0; i < ctx->region.unattr.overlay_ex.canvas_num; ++i)
-			if (ctx->canvas_info[i].phy_addr)
-				base_ion_free(ctx->canvas_info[i].phy_addr);
-	} else {
-		if (ctx->canvas_info[0].phy_addr)
-			base_ion_free(ctx->canvas_info[0].phy_addr);
+	if (vpss_available) {
+		/* Waiting for the VPSS to truly close the RGN. */
+		osal_msleep(200);
 	}
 
+	if (ret == 0)
+		_rgn_free_canvas(ctx);
+
 	cb_param.chn = ctx->chn;
 	cb_param.handle = handle;
 	if (ctx->canvas_info[ctx->canvas_idx].compressed) {
@@ -1748,7 +1780,8 @@ int rgn_detach_from_chn(rgn_handle handle, const mmf_chn_s *pchn)
 	}
 	cb_param.ow_inst = ctx->ow_inst;
 
-	if (ctx->region.type == OVERLAY_RGN || ctx->region.type == COVER_RGN) {
+	if (vpss_available && ow_inst_valid &&
+	    (ctx->region.type == OVERLAY_RGN || ctx->region.type == COVER_RGN)) {
 		if (_rgn_call_cb(E_MODULE_VPSS, VPSS_CB_CLR_RGN_OW_ADDR, &cb_param) != 0) {
 			TRACE_RGN(RGN_ERR, "VPSS_CB_CLR_RGN_OW_ADDR is failed\n");
 		}
@@ -1871,7 +1904,10 @@ int rgn_get_canvas_info(rgn_handle handle, rgn_canvas_info_s *pcanvas_info)
 
 		do {
 			in_use_param.in_use = 0;
-			if (_rgn_call_cb(E_MODULE_VPSS, VPSS_CB_IS_RGN_ADDR_IN_USE, &in_use_param) != 0) {
+			ret = _rgn_call_cb(E_MODULE_VPSS, VPSS_CB_IS_RGN_ADDR_IN_USE, &in_use_param);
+			if (ret != 0) {
+				if (_rgn_cb_is_vpss_unavailable(ret))
+					break;
 				TRACE_RGN(RGN_ERR, "VPSS_CB_IS_RGN_ADDR_IN_USE is failed\n");
 				return ERR_RGN_ILLEGAL_PARAM;
 			}
@@ -2062,6 +2098,8 @@ retry:
 	ctx->canvas_updated = true;
 	ret = _rgn_update_hw(ctx, RGN_OP_UPDATE);
 	ctx->canvas_updated = false;
+	if (_rgn_cb_is_vpss_unavailable(ret))
+		ret = OSAL_SUCCESS;
 
 	ctx->canvas_get = 0;
 	return ret;
diff --git a/interdrv/vpss/driver/vpss_core.c b/interdrv/vpss/driver/vpss_core.c
index 0791ef77..3208444c 100644
--- a/interdrv/vpss/driver/vpss_core.c
+++ b/interdrv/vpss/driver/vpss_core.c
@@ -201,6 +201,17 @@ static void _vpss_get_mlv_info(unsigned char snr_num, struct mlv_i_s *p_m_lv_i)
 {
 }
 
+static int _vpss_cb_grp_created(vpss_grp vpss_grp, struct vpss_cores *cores)
+{
+	if (cores == NULL)
+		return 0;
+
+	if (check_vpss_grp_valid(vpss_grp))
+		return 0;
+
+	return cores->ctx.grp_ctx[vpss_grp] && cores->ctx.grp_ctx[vpss_grp]->is_created;
+}
+
 static int _vpss_get_dev_idx(vpss_grp vpss_grp, vpss_chn vpss_chn, struct vpss_cores *cores)
 {
 	vpss_mode_s vpss_mode = {0};
@@ -218,6 +229,13 @@ static int _vpss_get_dev_idx(vpss_grp vpss_grp, vpss_chn vpss_chn, struct vpss_c
 		return ERR_VPSS_UNEXIST;
 	}
 
+	if (check_vpss_grp_valid(vpss_grp))
+		return 0;
+
+	if (!cores->ctx.grp_ctx[vpss_grp] || !cores->ctx.grp_ctx[vpss_grp]->is_created) {
+		return 0;
+	}
+
 	vpss_mode = cores->vpss_mode;
 	dev_id = cores->ctx.grp_ctx[vpss_grp]->dev_id;
 
@@ -277,6 +295,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(grp, chn, cores);
 
+		if (!_vpss_cb_grp_created(grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		if (dev_idx > 1)
 			layer = 0;
 
@@ -294,6 +317,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(grp, chn, cores);
 
+		if (!_vpss_cb_grp_created(grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		if (dev_idx > 1)
 			layer = 0;
 
@@ -310,6 +338,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(vpss_grp, vpss_chn, cores);
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		if (dev_idx > 1)
 			layer = 0;
 
@@ -330,6 +363,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		vpss_grp vpss_grp = attr->chn.dev_id;
 		vpss_chn vpss_chn = attr->chn.chn_id;
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		rc = vpss_set_rgn_coverex_cfg(vpss_grp, vpss_chn, &attr->rgn_coverex_cfg, &cores->ctx);
 		break;
 	}
@@ -340,6 +378,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		vpss_grp vpss_grp = attr->chn.dev_id;
 		vpss_chn vpss_chn = attr->chn.chn_id;
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		rc = vpss_set_rgn_mosaic_cfg(vpss_grp, vpss_chn, &attr->rgn_mosaic_cfg, &cores->ctx);
 		break;
 	}
@@ -351,6 +394,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		vpss_grp vpss_grp = attr->chn.dev_id;
 		vpss_chn vpss_chn = attr->chn.chn_id;
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		rc = vpss_set_rgn_lut_cfg(vpss_grp, vpss_chn, rgn_lut_cfg, &cores->ctx);
 		break;
 	}
@@ -363,6 +411,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(vpss_grp, vpss_chn, cores);
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		if (dev_idx > 1)
 			layer = 0;
 
@@ -378,6 +431,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(vpss_grp, vpss_chn, cores);
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		if (dev_idx > 1)
 			layer = 0;
 
@@ -393,6 +451,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		u32 layer = attr->layer;
 		u8 dev_idx = _vpss_get_dev_idx(vpss_grp, vpss_chn, cores);
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		if (dev_idx > 1)
 			layer = 0;
 
@@ -432,6 +495,11 @@ static int _vpss_core_cb(void *dev, cb_modules_id caller, u32 cmd, void *arg)
 		vpss_grp vpss_grp = attr->chn.dev_id;
 		vpss_chn vpss_chn = attr->chn.chn_id;
 
+		if (!_vpss_cb_grp_created(vpss_grp, cores)) {
+			rc = ERR_VPSS_UNEXIST;
+			break;
+		}
+
 		rc = vpss_get_chn_attr(vpss_grp, vpss_chn, &chn_attr, &cores->ctx);
 		attr->rect.width = chn_attr.width;
 		attr->rect.height = chn_attr.height;
-- 
